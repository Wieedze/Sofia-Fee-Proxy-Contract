{
  "name": "sofia-contracts-monorepo",
  "version": "2.0.0-alpha",
  "private": true,
  "description": "Intuition Fee Proxy — monorepo (contracts + SDK + webapp)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "contracts:compile": "bun --filter @sofia/contracts compile",
    "contracts:test": "bun --filter @sofia/contracts test",
    "contracts:clean": "bun --filter @sofia/contracts clean",
    "contracts:deploy:testnet": "bun --filter @sofia/contracts deploy:testnet",
    "contracts:deploy:mainnet": "bun --filter @sofia/contracts deploy:mainnet",
    "sdk:build": "bun --filter @sofia/sdk build",
    "sdk:sync": "bun run scripts/sync-abis.ts",
    "webapp:dev": "bun --filter @sofia/webapp dev",
    "webapp:build": "bun --filter @sofia/webapp build",
    "webapp:preview": "bun --filter @sofia/webapp preview"
  },
  "author": "Sofia Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  }
}
